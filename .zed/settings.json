{
  "languages": {
    "JavaScript": {
      "formatter": "prettier",
      "format_on_save": "on",
      "code_actions_on_format": { "source.fixAll.eslint": true }
    },
    "TypeScript": {
      "formatter": "prettier",
      "format_on_save": "on",
      "code_actions_on_format": { "source.fixAll.eslint": true }
    },
    "Vue.js": {
      "formatter": "prettier",
      "format_on_save": "on",
      "code_actions_on_format": { "source.fixAll.eslint": true }
    }
  },
  "lsp": {
    "eslint": {
      "settings": {
        "workingDirectory": { "mode": "auto" }
      }
    }
  }
}
